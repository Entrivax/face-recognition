# Keep the build context small and avoid leaking local artifacts.

# VCS
.git
.gitignore

# Build artifacts & local caches
recogn
.gocache/
.gopath/
.gomodcache/

# The web UI bundle is built inside the image (stage 3); host node_modules
# and a possibly stale host dist are excluded.
web/node_modules/
internal/web/dist/

# Downloaded models are fetched fresh inside the image build.
models/

# The ONNX Runtime C library is fetched fresh inside the image build (stage 1).
third_party/

# The Python sidecar was removed; nothing under python/ is needed.
python/

# The generated DB is runtime state, not source. Mounted as a volume.
data/

# Your dataset is mounted at runtime, not baked into the image.
people/

# Scratch / logs / OS noise
tmp/
*.log
.DS_Store

# Docker's own files
Dockerfile
.dockerignore
docker-compose.yml
